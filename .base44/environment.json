{
  "previewPort": 3000,
  "healthPath": "/",
  "startCommand": "docker compose -f docker-compose.base44.yml up -d",
  "secrets": [
    {"name": "NEXT_PUBLIC_SUPABASE_URL", "description": "Supabase project URL (https://xxxxx.supabase.co)", "requiredAtBoot": true},
    {"name": "NEXT_PUBLIC_SUPABASE_ANON_KEY", "description": "Supabase anon/public API key (client-side)", "requiredAtBoot": true},
    {"name": "SUPABASE_SERVICE_ROLE_KEY", "description": "Supabase service_role key (server-side API routes)", "requiredAtBoot": false},
    {"name": "RESEND_API_KEY", "description": "Resend API key for verification emails", "requiredAtBoot": false}
  ]
}
